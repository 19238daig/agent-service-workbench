# Copy to .env in the project root and fill in your model provider settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=your-model-name
MODEL_USE_SYSTEM_PROXY=false

# Optional: per-agent model. Empty values inherit MODEL_NAME.
INTENT_MODEL_NAME=
KNOWLEDGE_MODEL_NAME=
TICKET_MODEL_NAME=
COMPLIANCE_MODEL_NAME=

# Optional per-role overrides use INTENT / KNOWLEDGE / TICKET / COMPLIANCE.
# INTENT_OPENAI_BASE_URL=https://your-gateway.example/v1
# INTENT_OPENAI_API_KEY=
# INTENT_TEMPERATURE=0
# INTENT_TIMEOUT=60

# Full infrastructure readiness requires Redis; offline tests can use memory://.
REDIS_URL=redis://127.0.0.1:56379/0
FAISS_INDEX_PATH=vector_store/faiss_index
OTEL_SERVICE_NAME=smart-cs-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=false
HOST=127.0.0.1
PORT=8000

# Data foundation: generate a local database password with the configure command.
# python -m smart_cs.foundation configure
DATABASE_URL=
POSTGRES_USER=smart_cs
POSTGRES_DB=smart_cs
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_AUTO_CREATE=false
FOUNDATION_AUTO_START=true
APP_MODE=local_demo

# Local HTTP only. Set true when using HTTPS; authentication is always enabled.
AUTH_COOKIE_SECURE=false

# Optional local native-document RAG. Download and index before enabling it.
RAG_ENABLED=false
RAG_SOURCE_DIRECTORY=data/public-after-sales-v2/sources
RAG_EMBEDDING_URL=http://127.0.0.1:61535
RAG_EMBEDDING_MODEL=smart-cs-bge-m3
RAG_EMBEDDING_GGUF="path/to/bge-m3-f16.gguf"
RAG_RERANKER_URL=http://127.0.0.1:61536
RAG_RERANKER_PATH="path/to/local/bge-reranker-v2-m3"
RAG_WORKER_PYTHON="path/to/gpu-environment/python.exe"
RAG_OLLAMA_EXE="path/to/ollama.exe"
# Experimental threshold; tune on an independent validation set.
RAG_RERANK_MIN_SCORE=0.10
# Explicit ablation only. Disabled mode still requires evidence/permission checks.
RAG_RERANK_ENABLED=true

# Step nineteen. Run migrations, then python scripts/configure_jobs.py.
JOB_DB_USER=smart_cs_jobs
JOB_DB_PASSWORD=
JOB_BROKER_URL=redis://127.0.0.1:56380/0
JOB_REDIS_PORT=56380
JOB_WORKER_AUTO_START=false
# Optional build-only public package mirror; package versions remain pinned.
WORKER_PIP_INDEX_URL=https://pypi.org/simple

# Durable chat execution; closing a subscription does not cancel the run.
RUN_EXECUTOR_ENABLED=true
RUN_EXECUTOR_CONCURRENCY=2
RUN_MAX_SECONDS=600

# Dense rollback or validated Chinese BM25 + RRF
RAG_RETRIEVAL_MODE=dense

# Step 25. Budgets/profile: src/smart_cs/performance/profile.json
# Cache trades first-query overhead for repeated same-principal questions.
PERF_ENABLED=true
PERF_CACHE_ENABLED=true

# Optional exact browser origins for an alternate local port, comma separated.
# Keep empty for the standard 8000/5173 local development origins.
APP_ORIGINS=
