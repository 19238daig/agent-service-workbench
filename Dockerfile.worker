FROM python:3.12-slim
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SMART_CS_PROJECT_ROOT=/app PYTHONPATH=/app/src
WORKDIR /app
COPY requirements.lock.txt /app/requirements.lock.txt
COPY requirements.worker.txt /app/requirements.worker.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install --timeout 120 --retries 8 -r requirements.worker.txt -c requirements.lock.txt && useradd --uid 10001 --create-home worker
COPY src /app/src
COPY docs/business-scope.md /app/docs/business-scope.md
USER worker
CMD ["celery", "-A", "smart_cs.background.celery_app:app", "worker", "--loglevel=WARNING", "--concurrency=1"]
